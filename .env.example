# Variáveis de ambiente — SÓ OS NOMES, sem valores.
# Copie para .env.local na sua máquina e preencha lá. Nunca envie valores para o GitHub nem para o chat.
# O gateway tem a lista própria em services/helena-gateway/.env.example.

# --- App (React/Vite, pasta src/) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_HELENA_GATEWAY_URL=
VITE_HELENA_GATEWAY_FALLBACK_URL=
VITE_HELENA_R2_ACCOUNT_ID=
VITE_HELENA_R2_BUCKET=
VITE_HELENA_V2_HABILITADA=
# Modo de teste sem senha: deixe VAZIO fora do computador de desenvolvimento (ele abre o app sem login).
VITE_MODO_TESTE_SEM_SENHA=
VITE_TESTE_EMAIL=
VITE_TESTE_SENHA=

# --- Scripts (pasta scripts/) ---
HELENA_HERMES_LOGIN_TOKEN=
TYPESAFE_API_KEY=
# Para quando os scripts deixarem de ter a chave escrita no código (ver docs/decisoes/DEC-027):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco da v2, só para testes (pasta supabase/migrations-v2) ---
# Aponte SÓ para um PostgreSQL local ou de CI, nunca para o Supabase real. Vazio: o teste sobe o próprio PostgreSQL local.
HELENA_V2_TESTE_DATABASE_URL=
# Pasta bin do PostgreSQL, se ele não estiver em /usr/lib/postgresql/*/bin:
HELENA_V2_PG_BIN=
