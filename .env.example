# Variáveis de ambiente — SÓ OS NOMES, sem valores.
# Copie para .env.local na sua máquina e preencha lá. Nunca envie valores para o GitHub nem para o chat.
# O gateway tem a lista própria em services/helena-gateway/.env.example.

# --- App (React/Vite, pasta src/) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_HELENA_GATEWAY_URL=
VITE_HELENA_GATEWAY_FALLBACK_URL=
VITE_HELENA_R2_ACCOUNT_ID=
VITE_HELENA_R2_BUCKET=
VITE_HELENA_V2_HABILITADA=
# Modo de teste sem senha: deixe VAZIO fora do computador de desenvolvimento (ele abre o app sem login).
VITE_MODO_TESTE_SEM_SENHA=
VITE_TESTE_EMAIL=
VITE_TESTE_SENHA=

# --- Scripts (pasta scripts/) ---
HELENA_HERMES_LOGIN_TOKEN=
TYPESAFE_API_KEY=
# Para quando os scripts deixarem de ter a chave escrita no código (ver docs/decisoes/DEC-027):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco da v2, só para testes (pasta supabase/migrations-v2) ---
# Aponte SÓ para um PostgreSQL local ou de CI, nunca para o Supabase real. Vazio: o teste sobe o próprio PostgreSQL local.
HELENA_V2_TESTE_DATABASE_URL=
# Pasta bin do PostgreSQL, se ele não estiver em /usr/lib/postgresql/*/bin:
HELENA_V2_PG_BIN=

# --- Motor da v2 em modo real (motor/orquestrador). SÓ OS NOMES; só o fundador preenche, e só depois da frase de autorização ---
# Qual runtime de agente usar. Vazio = hermes. Os nomes aceitos estão no registro (motor/executor/executor_helena/registro.py).
HELENA_V2_EXECUTOR=
# Bancos do motor: um para os cards e outro, separado, para o DBOS (os dois com conexão dedicada, TLS e papel mínimo).
HELENA_V2_DATABASE_URL=
HELENA_V2_DBOS_SYSTEM_DATABASE_URL=
# Exigidos pelo executor "hermes" (cada executor novo declara os seus no registro):
HELENA_V2_HERMES_BIN=
HELENA_V2_HERMES_HOME=
HELENA_V2_EXECUCOES_DIR=
# Executor "openclaw" (PRONTO PARA CONECTAR, ainda não aprovado; veja docs/manual/conectar-runtimes.md):
# caminho absoluto do binário e a pasta OPENCLAW_HOME onde o fundador fez o login da assinatura. Não são segredos.
HELENA_V2_OPENCLAW_BIN=
HELENA_V2_OPENCLAW_HOME=
# Opcional: PATH do processo do OpenClaw (vazio = pasta do binário + /usr/local/bin:/usr/bin:/bin).
HELENA_V2_OPENCLAW_PATH=
# Executor "eve" (PRONTO PARA CONECTAR, ainda não aprovado): endereço https do servidor da EVE e a credencial da rota.
# HELENA_V2_EVE_TOKEN é segredo: nunca em código, log, relatório ou conversa.
HELENA_V2_EVE_URL=
HELENA_V2_EVE_TOKEN=

# --- Alarme por webhook do vigia (comando `vigiar --canal-webhook`). SÓ O NOME; só o fundador preenche ---
# URL https:// do canal de aviso INDEPENDENTE do servidor da v2. É segredo: nunca em código, log, relatório ou conversa.
HELENA_V2_ALARME_WEBHOOK_URL=
