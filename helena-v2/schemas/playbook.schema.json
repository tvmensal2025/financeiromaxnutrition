{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helena-v2/playbook",
  "title": "Roteiro de meta",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "empresa", "prioridade", "prazo_dias", "decisoes", "orcamento_meta", "etapas"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "empresa": { "type": "string", "pattern": "^BIZ-[0-9]{3}$" },
    "prioridade": { "type": "integer", "minimum": 1, "maximum": 5 },
    "prazo_dias": { "type": "integer", "minimum": 1, "maximum": 90 },
    "decisoes": { "type": "array", "items": { "type": "string", "pattern": "^DEC-[0-9]{3}$" } },
    "orcamento_meta": { "type": "object", "additionalProperties": false, "required": ["buscas", "tarefas", "horas_modelo"],
      "properties": { "buscas": { "type": "integer", "minimum": 0 }, "tarefas": { "type": "integer", "minimum": 1 }, "horas_modelo": { "type": "number", "minimum": 0.1 } } },
    "entradas_externas": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^JOB-HR-[0-9a-f]{32}$" } },
    "etapas": { "type": "array", "minItems": 1, "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "responsavel", "entrega", "objetivo", "entradas", "depende_de"],
      "properties": {
        "id": { "type": "string", "pattern": "^E[0-9]{1,2}$" },
        "responsavel": { "type": "string", "pattern": "^AGT-[0-9]{2}$" },
        "entrega": { "type": "string", "pattern": "^[a-z_]+$" },
        "objetivo": { "type": "string", "maxLength": 350 },
        "entradas": { "type": "array", "items": { "type": "string" } },
        "depende_de": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]{1,2}$" } },
        "dividir_por": { "type": "array", "items": { "type": "string" } },
        "se_semaforo": { "type": "object", "additionalProperties": false, "properties": {
          "AJUSTE": { "type": "object", "additionalProperties": false, "required": ["refazer", "com_entrada", "reconferir_por", "max_ciclos"],
            "properties": { "refazer": { "type": "array", "items": { "type": "string" } }, "com_entrada": { "type": "string" }, "reconferir_por": { "type": "string" }, "max_ciclos": { "type": "integer", "minimum": 1, "maximum": 2 } } },
          "NAO_PODE": { "type": "object", "properties": { "aguardar_fundador": { "const": true } }, "required": ["aguardar_fundador"] } } }
      } } },
    "acoes_do_fundador": { "type": "array", "items": { "type": "string" } }
  }
}
