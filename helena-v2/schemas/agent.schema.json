{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helena-v2/agent",
  "title": "Ficha de agente",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nome", "funcao", "papel", "produz", "ferramentas", "modelo", "orcamento", "orcamento_revisao", "revisor", "regras", "nunca"],
  "properties": {
    "id": { "type": "string", "pattern": "^AGT-[0-9]{2}$" },
    "nome": { "type": "string", "minLength": 2, "maxLength": 40 },
    "funcao": { "type": "string", "minLength": 3, "maxLength": 80 },
    "papel": { "enum": ["ORQUESTRADORA", "ESPECIALISTA"] },
    "missao": { "type": "string", "maxLength": 600 },
    "produz": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z_]+$" }, "description": "Tipos de entrega (arquivos em deliverables/) que este agente pode produzir" },
    "revisa": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+$" }, "description": "Tipos de entrega que este agente pode revisar (nunca as proprias)" },
    "ferramentas": { "type": "array", "items": { "enum": ["web_search", "web_extract", "vision_analyze", "registrar_lancamento", "get_visual_asset", "gerar_imagem"] } },
    "modelo": { "type": "string", "description": "Apelido do catalogo models.yaml, nunca o nome do modelo" },
    "orcamento": {
      "type": "object", "additionalProperties": false,
      "required": ["tempo_s", "passos", "buscas"],
      "properties": {
        "tempo_s": { "type": "integer", "minimum": 60, "maximum": 900 },
        "passos": { "type": "integer", "minimum": 4, "maximum": 40 },
        "buscas": { "type": "integer", "minimum": 0, "maximum": 25 }
      }
    },
    "orcamento_revisao": { "type": "object", "additionalProperties": false, "required": ["tempo_s", "passos", "buscas"], "properties": { "tempo_s": { "type": "integer", "minimum": 60, "maximum": 600 }, "passos": { "type": "integer", "minimum": 4, "maximum": 20 }, "buscas": { "type": "integer", "minimum": 0, "maximum": 5 } } },
    "revisor": { "type": "string", "pattern": "^(AGT-[0-9]{2}|CODIGO|FUNDADOR)$", "description": "Revisor padrao (CODIGO = so validacao mecanica; FUNDADOR = aprovacao do Fundador); nunca o proprio autor" },
    "regras": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "maxLength": 240 } },
    "nunca": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 200 } },
    "aprendizados": { "type": "array", "items": { "type": "object", "required": ["regra", "origem", "aprovado_em"], "properties": { "regra": { "type": "string" }, "origem": { "type": "string" }, "aprovado_em": { "type": "string" } } } }
  }
}
