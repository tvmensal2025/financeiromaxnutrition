PORT=3000
PUBLIC_HOST=gateway.seudominio.com

SUPABASE_URL=https://wxkgrykduqtsgmjkzlou.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_SUA_CHAVE_AQUI

GATEWAY_WEBHOOK_SECRET=CONFIGURAR_SOMENTE_NO_EASYPANEL
MEOWCALLER_TOKEN=CONFIGURAR_SOMENTE_NO_EASYPANEL
MCP_BEARER_TOKEN=CONFIGURAR_SOMENTE_NO_EASYPANEL

# Credenciais individuais Hermes: somente hashes SHA-256 e profile_slug no servidor.
# Array vazio desabilita acesso de perfis. Nunca entregar MCP_BEARER_TOKEN aos agentes.
# Cada entrada usa {"profile_slug":"...","sha256":"..."}; sem tokens em texto neste arquivo.
# Exige tambem agent_runtime_bindings ACTIVE com referencia de homologacao.
HERMES_PROFILE_TOKEN_HASHES=[]

# API de execucao do Hermes. Permanece desligada ate a rota por perfil estar
# acessivel do Gateway e a chave de cada perfil ser configurada no EasyPanel.
HERMES_API_ENABLED=false
HERMES_API_BASE_URL=
HERMES_API_KEYS_JSON={}

DISPATCH_COOLDOWN_SECONDS=180
SCHEDULE_TICK_MS=15000
OUTBOX_TICK_MS=15000

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Segredo compartilhado do webhook Evolution (obrigatório em produção; fail-closed se vazio)
# Preencher somente no EasyPanel. Sem valor no repositório.
EVOLUTION_WEBHOOK_SECRET=

# Identidade do canal WhatsApp (par completo: id da empresa + marca exibida)
# Sem os dois, o canal usa texto neutro e business_id UNASSIGNED — nunca afirma uma marca que não bata com o id.
WHATSAPP_BUSINESS_ID=CONFIGURAR_SOMENTE_NO_EASYPANEL
WHATSAPP_BRAND_NAME=CONFIGURAR_SOMENTE_NO_EASYPANEL

# Janela (ms) para não repetir a mesma auto-resposta ao mesmo número. Padrão: 60000
WHATSAPP_AUTOREPLY_DEBOUNCE_MS=60000
