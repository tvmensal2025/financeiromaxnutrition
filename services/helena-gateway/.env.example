PORT=3000
PUBLIC_HOST=gateway.seudominio.com

SUPABASE_URL=https://wxkgrykduqtsgmjkzlou.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CONFIGURAR_SOMENTE_NO_EASYPANEL

GATEWAY_WEBHOOK_SECRET=CONFIGURAR_SOMENTE_NO_EASYPANEL
MCP_BEARER_TOKEN=CONFIGURAR_SOMENTE_NO_EASYPANEL

# Hashes SHA-256 por profile_slug; [] desabilita os perfis Hermes.
# Nao entregar o token administrativo acima aos perfis.
HERMES_PROFILE_TOKEN_HASHES=[]

DISPATCH_COOLDOWN_SECONDS=180
SCHEDULE_TICK_MS=15000
OUTBOX_TICK_MS=15000

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Segredo compartilhado do webhook Evolution (obrigatório em produção; fail-closed se vazio)
# Preencher somente no EasyPanel. Sem valor no repositório.
EVOLUTION_WEBHOOK_SECRET=

# Identidade do canal WhatsApp (par completo: id da empresa + marca exibida)
# Sem os dois, o canal usa texto neutro e business_id UNASSIGNED — nunca afirma uma marca que não bata com o id.
WHATSAPP_BUSINESS_ID=CONFIGURAR_SOMENTE_NO_EASYPANEL
WHATSAPP_BRAND_NAME=CONFIGURAR_SOMENTE_NO_EASYPANEL

# Janela (ms) para não repetir a mesma auto-resposta ao mesmo número. Padrão: 60000
WHATSAPP_AUTOREPLY_DEBOUNCE_MS=60000

# ============================================
# GOOGLE CHIRP 3 HD — SOMENTE LIGAÇÕES (CALL)
# ============================================
CALL_TTS_PROVIDER=google_chirp3_hd
GOOGLE_CALL_TTS_ENABLED=true
GOOGLE_TTS_CREDENTIALS_B64=
GOOGLE_CLOUD_PROJECT_ID=
# Opcional se usar Application Default Credentials (ADC); caminho no servidor se usar arquivo JSON:
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CALL_TTS_LANGUAGE=pt-BR
GOOGLE_CALL_TTS_VOICE=pt-BR-Chirp3-HD-Achernar
GOOGLE_CALL_TTS_ENCODING=MP3
GOOGLE_CALL_TTS_SAMPLE_RATE=24000
GOOGLE_CALL_TTS_TIMEOUT_MS=5000
GOOGLE_CALL_TTS_MONTHLY_SOFT_LIMIT=900000
GOOGLE_CALL_TTS_WARN_PERCENT=80
GOOGLE_CALL_TTS_STOP_PERCENT=95
GOOGLE_CALL_TTS_FALLBACK=none
