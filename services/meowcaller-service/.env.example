# Configuração do Meowcaller Service (Sistema Helena)
# NOTA: NUNCA INSERIR CREDENCIAIS REAIS NESTE ARQUIVO

PORT=8002
INTERNAL_API_KEY=sua_chave_interna_secreta
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VOICE_PLATFORM_URL=ws://voice-platform:8000/v1/voice/stream
VOICE_PLATFORM_API_KEY=
WHATSAPP_SESSION_PATH=/data/whatsapp.db
LOG_LEVEL=info
CALL_MAX_DURATION_SECONDS=300
ENABLE_AUTO_ANSWER_CONTROLLED_NUMBERS=false
